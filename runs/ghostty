#!/usr/bin/env bash
set -euo pipefail

OS="$(uname -s)"

case "$OS" in
    Linux)
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"
        ;;
    Darwin)
        command -v brew >/dev/null 2>&1 || { echo "brew required on macOS; run ./run _brew first" >&2; exit 1; }
        brew install --cask ghostty
        ;;
    *) echo "Unsupported OS: $OS" >&2; exit 1 ;;
esac
