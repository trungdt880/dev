#!/usr/bin/env bash

set -euo pipefail

OS="$(uname -s)"

# On macOS, Homebrew is the cleanest path — and we don't have the sudo
# constraint we have on remote linux boxes. Install all tools via brew
# and exit.
if [[ "$OS" == "Darwin" ]]; then
    command -v brew >/dev/null 2>&1 || {
        echo "brew required on macOS; run ./run _brew first" >&2
        exit 1
    }
    brew install fd bat ripgrep eza yazi git-delta zoxide lazygit neovim
    echo "✔ tools installed via brew"
    exit 0
fi

if [[ "$OS" != "Linux" ]]; then
    echo "Unsupported OS: $OS" >&2
    exit 1
fi

# --- Linux: download static binaries from GitHub releases (no sudo) ----------

LOCAL_BIN="$HOME/.local/bin"
TMP_DIR="/tmp/cli-install"

mkdir -p "$LOCAL_BIN"
rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"

has_command() {
    command -v "$1" &>/dev/null
}

# Pick the right value for the running CPU. Usage:
#   arch_select <x86_64-value> <aarch64-value>
# Returns non-zero (and warns) on an arch we don't ship binaries for, so the
# caller can skip that single tool instead of aborting the whole run.
arch_select() {
    case "$(uname -m)" in
    x86_64 | amd64) printf '%s\n' "$1" ;;
    aarch64 | arm64) printf '%s\n' "$2" ;;
    *)
        echo "  ✗ unsupported arch: $(uname -m)" >&2
        return 1
        ;;
    esac
}

# Resolve the published tag of a repo's latest release (e.g. "v0.19.2").
# Prefers jq when present, falls back to grep so it still works on a bare box.
gh_latest_tag() {
    local repo="$1" json tag
    json=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null) || {
        echo "  ✗ could not reach GitHub API for ${repo} (rate-limited?)" >&2
        return 1
    }
    if has_command jq; then
        tag=$(printf '%s' "$json" | jq -r '.tag_name // empty')
    else
        tag=$(printf '%s' "$json" | grep '"tag_name"' | head -1 | cut -d '"' -f 4)
    fi
    [[ -n "$tag" ]] || {
        echo "  ✗ could not parse latest tag for ${repo}" >&2
        return 1
    }
    printf '%s\n' "$tag"
}

# Download a URL to a file, failing loudly on HTTP errors (so we never feed a
# 404 HTML page into tar) and retrying transient network hiccups.
fetch() {
    curl -fSL --retry 3 --retry-delay 2 -o "$2" "$1"
}

# The common shape: download a tar/zip, find a single named binary anywhere
# inside (top-level OR versioned subdir), and install it. Robust to layout
# differences between projects.
#   install_archive <bin-name> <url>
install_archive() {
    local bin="$1" url="$2"
    local work archive found
    work="$(mktemp -d "${TMP_DIR}/${bin}.XXXXXX")"
    archive="${work}/${url##*/}"

    echo "  ↓ ${url}"
    fetch "$url" "$archive" || {
        echo "  ✗ download failed for ${bin}" >&2
        rm -rf "$work"
        return 1
    }

    case "$archive" in
    *.zip) unzip -q -o "$archive" -d "$work" ;;
    *.tar.gz | *.tgz) tar -xzf "$archive" -C "$work" ;;
    *.tar.* | *.tar) tar -xf "$archive" -C "$work" ;;
    *)
        echo "  ✗ unknown archive type: ${archive}" >&2
        rm -rf "$work"
        return 1
        ;;
    esac || {
        echo "  ✗ extract failed for ${bin}" >&2
        rm -rf "$work"
        return 1
    }

    found="$(find "$work" -type f -name "$bin" 2>/dev/null | head -1)"
    if [[ -z "$found" ]]; then
        echo "  ✗ '${bin}' binary not found in archive" >&2
        rm -rf "$work"
        return 1
    fi

    install -m 0755 "$found" "${LOCAL_BIN}/${bin}"
    rm -rf "$work"
    echo "  ✔ ${bin} installed to ${LOCAL_BIN}"
}

install_fd() {
    has_command fd && { echo "  ✔ fd already installed"; return; }
    local tag triple
    tag=$(gh_latest_tag sharkdp/fd) || return 1
    triple=$(arch_select x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu) || return 1
    install_archive fd "https://github.com/sharkdp/fd/releases/download/${tag}/fd-${tag}-${triple}.tar.gz"
}

install_bat() {
    has_command bat && { echo "  ✔ bat already installed"; return; }
    local tag triple
    tag=$(gh_latest_tag sharkdp/bat) || return 1
    triple=$(arch_select x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu) || return 1
    install_archive bat "https://github.com/sharkdp/bat/releases/download/${tag}/bat-${tag}-${triple}.tar.gz"
}

install_rg() {
    has_command rg && { echo "  ✔ ripgrep already installed"; return; }
    local tag triple
    tag=$(gh_latest_tag BurntSushi/ripgrep) || return 1
    # NB: ripgrep ships x86_64 as musl but aarch64 only as gnu — there is no
    # aarch64 musl asset. Getting this wrong is what broke aarch64 boxes.
    triple=$(arch_select x86_64-unknown-linux-musl aarch64-unknown-linux-gnu) || return 1
    install_archive rg "https://github.com/BurntSushi/ripgrep/releases/download/${tag}/ripgrep-${tag}-${triple}.tar.gz"
}

install_eza() {
    has_command eza && { echo "  ✔ eza already installed"; return; }
    local tag triple
    tag=$(gh_latest_tag eza-community/eza) || return 1
    triple=$(arch_select x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu) || return 1
    install_archive eza "https://github.com/eza-community/eza/releases/download/${tag}/eza_${triple}.tar.gz"
}

install_yazi() {
    has_command yazi && { echo "  ✔ yazi already installed"; return; }
    local tag triple
    tag=$(gh_latest_tag sxyazi/yazi) || return 1
    triple=$(arch_select x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu) || return 1
    install_archive yazi "https://github.com/sxyazi/yazi/releases/download/${tag}/yazi-${triple}.zip"
}

install_delta() {
    has_command delta && { echo "  ✔ delta already installed"; return; }
    local tag triple
    tag=$(gh_latest_tag dandavison/delta) || return 1
    triple=$(arch_select x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu) || return 1
    install_archive delta "https://github.com/dandavison/delta/releases/download/${tag}/delta-${tag}-${triple}.tar.gz"
}

install_zoxide() {
    has_command zoxide && { echo "  ✔ zoxide already installed"; return; }
    local tag triple ver
    tag=$(gh_latest_tag ajeetdsouza/zoxide) || return 1
    ver="${tag#v}"
    triple=$(arch_select x86_64-unknown-linux-musl aarch64-unknown-linux-musl) || return 1
    install_archive zoxide "https://github.com/ajeetdsouza/zoxide/releases/download/${tag}/zoxide-${ver}-${triple}.tar.gz"
}

install_lazygit() {
    has_command lazygit && { echo "  ✔ lazygit already installed"; return; }
    local tag triple ver
    tag=$(gh_latest_tag jesseduffield/lazygit) || return 1
    ver="${tag#v}"
    triple=$(arch_select Linux_x86_64 Linux_arm64) || return 1
    install_archive lazygit "https://github.com/jesseduffield/lazygit/releases/download/${tag}/lazygit_${ver}_${triple}.tar.gz"
}

# nvim ships a whole runtime tree (not a single binary), so it gets its own
# install path: extract into ~/.local/share/nvim and symlink the launcher.
# Always reinstalls to track latest.
install_nvim() {
    local tag variant url work archive srcdir dest
    tag=$(gh_latest_tag neovim/neovim) || return 1
    variant=$(arch_select linux-x86_64 linux-arm64) || return 1
    url="https://github.com/neovim/neovim/releases/download/${tag}/nvim-${variant}.tar.gz"

    work="$(mktemp -d "${TMP_DIR}/nvim.XXXXXX")"
    archive="${work}/nvim.tar.gz"

    echo "  ↓ ${url}"
    fetch "$url" "$archive" || {
        echo "  ✗ nvim download failed" >&2
        rm -rf "$work"
        return 1
    }
    tar -xzf "$archive" -C "$work" || {
        echo "  ✗ nvim extract failed" >&2
        rm -rf "$work"
        return 1
    }

    srcdir="${work}/nvim-${variant}"
    [[ -d "$srcdir" ]] || srcdir="$(find "$work" -maxdepth 1 -type d -name 'nvim-*' | head -1)"
    if [[ -z "$srcdir" || ! -x "${srcdir}/bin/nvim" ]]; then
        echo "  ✗ nvim payload not found in archive" >&2
        rm -rf "$work"
        return 1
    fi

    dest="${HOME}/.local/share/nvim/nvim-${variant}"
    mkdir -p "$(dirname "$dest")"
    rm -rf "$dest"
    mv "$srcdir" "$dest"
    ln -sf "${dest}/bin/nvim" "${LOCAL_BIN}/nvim"
    rm -rf "$work"

    if "${LOCAL_BIN}/nvim" --version >/dev/null 2>&1; then
        echo "  ✔ nvim ${tag} installed (${dest})"
    else
        echo "  ✗ nvim installed but won't run" >&2
        return 1
    fi
}

##################################################
# Main
##################################################

FAILED=()

run_install() {
    local name="$1"
    echo "── ${name} ──"
    # Run inside an `if` so a failing tool returns cleanly instead of aborting
    # the whole script under `set -e`.
    if "install_${name}"; then
        :
    else
        FAILED+=("$name")
    fi
}

for tool in fd bat rg eza yazi delta nvim zoxide lazygit; do
    run_install "$tool"
done

echo
if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo "⚠ Some tools failed: ${FAILED[*]}"
    echo "  (re-run ./run tools to retry — already-installed tools are skipped)"
else
    echo "✅ All tools installed."
fi
echo "➡ Make sure ${HOME}/.local/bin is in your PATH!"
