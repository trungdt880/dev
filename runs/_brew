#!/usr/bin/env bash
#
# Bootstrap Homebrew on macOS. Other runs/* scripts assume brew is on PATH
# when running on mac; run this first.
#
# Naming: leading underscore sorts before letters in ASCII, so `./run` (no
# filter) executes this before mac branches in conda/docker/ghostty/etc.

set -euo pipefail

OS="$(uname -s)"
if [[ "$OS" != "Darwin" ]]; then
    echo "[skip] _brew is mac-only (OS=$OS)"
    exit 0
fi

if command -v brew >/dev/null 2>&1; then
    echo "[skip] Homebrew already installed: $(brew --prefix)"
    exit 0
fi

echo "Installing Homebrew..."
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Ensure brew is on PATH for subsequent runs/ invocations in the same session
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
