#!/usr/bin/env bash
set -euo pipefail

OS="$(uname -s)"

case "$OS" in
    Linux)
        sudo apt-get install -y tmux
        ;;
    Darwin)
        command -v brew >/dev/null 2>&1 || { echo "brew required on macOS; run ./run _brew first" >&2; exit 1; }
        brew install tmux
        ;;
    *) echo "Unsupported OS: $OS" >&2; exit 1 ;;
esac
git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
