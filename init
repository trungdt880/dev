#!/usr/bin/env bash
set -euo pipefail

# Initialize git submodules (nvim config). Safe to re-run.
# DEV_ENV must point at this repo; we use absolute paths so the script
# works regardless of caller CWD.

if [ -z "${DEV_ENV:-}" ]; then
    echo "env var DEV_ENV needs to be present" >&2
    exit 1
fi

cd "$DEV_ENV"
git submodule init
git submodule update

pushd "$DEV_ENV/env/.config/nvim" &>/dev/null || exit 1
git checkout main
popd &>/dev/null || exit 1
