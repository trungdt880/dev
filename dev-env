#!/usr/bin/env bash
#
# Provision dotfiles for the current workstation by composing layers.
#
# Layers (each mirrors $HOME):
#   env/base/             — always applied; safe on bare servers
#   env/desktop/common/   — GUI tools shared between mac and linux personal
#   env/desktop/mac/      — mac-only GUI
#   env/desktop/linux/    — linux-only GUI
#   env/host/<ws>/        — per-headless-host tweaks
#
# Workstation -> ordered layer list lives in WS_LAYERS below.
# Later layers overwrite earlier ones for files that collide.
#
# Two copy semantics inside apply_layer:
#   - .config/<tool>/   wipe-and-replace the whole tool dir (atomic).
#                       Each tool dir is owned by exactly one layer.
#   - everything else   file-level mirror at arbitrary depth (merge).
#                       Top-level dotfiles, .local/scripts/*, deeply nested
#                       singletons like .oh-my-zsh/custom/<theme> compose
#                       across layers.

set -euo pipefail

dry_run="0"
YELLOW='\033[33m'
RED='\033[31m'
NC='\033[0m'

if [ -z "${XDG_CONFIG_HOME:-}" ]; then
    echo "no xdg config set"
    echo "using ~/.config"
    XDG_CONFIG_HOME="$HOME/.config"
fi

if [ -z "${DEV_ENV:-}" ]; then
    echo "env var DEV_ENV needs to be present" >&2
    exit 1
fi

if [ -z "${WS:-}" ]; then
    echo "env var WS needs to be present" >&2
    exit 1
fi

if [[ "${1:-}" == "-d" || "${1:-}" == "--dry" || "${1:-}" == "--dry-run" ]]; then
    dry_run="1"
fi

# Workstation -> ordered layer paths (relative to $DEV_ENV/env/).
declare -A WS_LAYERS=(
    [mac]="base desktop/common desktop/mac"
    [linux]="base desktop/common desktop/linux"
    [server]="base host/server"
    [waiv]="base host/waiv"
    [etri]="base host/etri"
    [q]="base host/q"
)

if [[ -z "${WS_LAYERS[$WS]:-}" ]]; then
    echo "Warning: Unknown WS environment value: $WS" >&2
    exit 1
fi

echo "Detected workstation: WS=$WS"

# Q uses a separate private-creds repo at $DEV_ENV/workdev; its env/ tree
# is appended as the last layer so its files override base.
extra_layers=()
if [[ "$WS" == "q" ]]; then
    if [ ! -d "$DEV_ENV/workdev" ]; then
        echo "Error: \$DEV_ENV/workdev does not exist. Clone the private repo there first." >&2
        exit 1
    fi
    if [ -d "$DEV_ENV/workdev/env" ]; then
        extra_layers+=("$DEV_ENV/workdev/env")
    fi
fi

log() {
    if [[ "$dry_run" == "1" ]]; then
        echo -e "[DRY_RUN]: $1"
    else
        echo -e "$1"
    fi
}

# Refuse to remove empty, root, or $HOME paths
safe_rm() {
    local target="$1"
    if [[ -z "$target" || "$target" == "/" || "$target" == "$HOME" ]]; then
        echo "safe_rm: refusing to remove '$target'" >&2
        exit 1
    fi
    rm -rf -- "$target"
}

apply_layer() {
    local layer="$1"
    local layer_name
    if [[ "$layer" == "$DEV_ENV/"* ]]; then
        layer_name="${layer#"$DEV_ENV/"}"
    else
        layer_name="$layer"
    fi

    if [[ ! -d "$layer" ]]; then
        log "[skip layer] $layer_name (no such directory)"
        return 0
    fi

    log "${YELLOW}=== applying layer: $layer_name ===${NC}"

    # 1. .config/<tool>/ — wipe-and-replace per top-level entry.
    if [[ -d "$layer/.config" ]]; then
        while IFS= read -r -d '' src; do
            local name dst
            name="$(basename "$src")"
            dst="${XDG_CONFIG_HOME%/}/$name"
            log "  ${RED}[wipe] $dst${NC} (owned by: $layer_name)"
            if [[ "$dry_run" == "0" ]]; then
                safe_rm "$dst"
            fi
            log "  ${YELLOW}[copy] .config/$name -> $dst${NC}"
            if [[ "$dry_run" == "0" ]]; then
                cp -r "$src" "$dst"
            fi
        done < <(find "$layer/.config" -mindepth 1 -maxdepth 1 -print0)
    fi

    # 2. All other files — file-level mirror at arbitrary depth.
    while IFS= read -r -d '' src; do
        local rel dst
        rel="${src#"$layer/"}"
        dst="$HOME/$rel"
        if [[ "$dry_run" == "0" ]]; then
            mkdir -p "$(dirname "$dst")"
        fi
        log "  ${YELLOW}[file] $rel -> $dst${NC} (owned by: $layer_name)"
        if [[ "$dry_run" == "0" ]]; then
            rm -f -- "$dst"
            cp "$src" "$dst"
        fi
    done < <(find "$layer" -mindepth 1 \( -type f -o -type l \) -not -path "$layer/.config/*" -not -name '.gitkeep' -print0)
}

log "env: $DEV_ENV"

# Apply layers in declared order; last layer wins for any colliding file.
read -r -a layers <<< "${WS_LAYERS[$WS]}"
for L in "${layers[@]}"; do
    apply_layer "$DEV_ENV/env/$L"
done
for L in "${extra_layers[@]}"; do
    apply_layer "$L"
done

# Always ship the canonical dev-env script into ~/.local/scripts so it
# can be run from anywhere.
mkdir -p "$HOME/.local/scripts"
log "${YELLOW}[file] dev-env -> $HOME/.local/scripts/dev-env${NC}"
if [[ "$dry_run" == "0" ]]; then
    cp "$DEV_ENV/dev-env" "$HOME/.local/scripts/dev-env"
fi

mkdir -p "$HOME/.local/bin"

if [[ "$dry_run" == "0" ]]; then
    if command -v conda &>/dev/null; then
        echo "Conda found, initializing..."

        # Move the 'conda initialize' block out of ~/.zshrc / ~/.bashrc into
        # the *.local files so the main rc files stay clean. `sed -i` syntax
        # differs between BSD (mac) and GNU (linux); -i.bak works on both.
        conda_block_start='/>>> conda initialize >>>/'
        conda_block_end='/<<< conda initialize <<</'

        conda init zsh
        sed -n "${conda_block_start},${conda_block_end}p" ~/.zshrc >>~/.zshrc.local
        sed -i.bak "${conda_block_start},${conda_block_end}d" ~/.zshrc && rm -f ~/.zshrc.bak

        conda init bash
        sed -n "${conda_block_start},${conda_block_end}p" ~/.bashrc >>~/.bashrc.local
        sed -i.bak "${conda_block_start},${conda_block_end}d" ~/.bashrc && rm -f ~/.bashrc.bak
    else
        echo "Conda not found in PATH. Skipping initialization."
    fi
fi
