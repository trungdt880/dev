export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
VIM="nvim"

export DEV_ENV=${DEV_ENV:-$HOME/personal/dev}

PERSONAL=$XDG_CONFIG_HOME/personal
if [ -d "$PERSONAL" ]; then
    for i in `find -L $PERSONAL`; do
        [ -f "$i" ] && source $i
    done
fi


export GIT_EDITOR=$VIM

dev_env() {

}

#Custom binding
bindkey -s '^o' 'EDITOR=nvim yy\n'  # zsh
bindkey -s ^f "t\n"
# bindkey -s '\eh' "tmux-sessionizer -s 0\n"
# bindkey -s '\et' "tmux-sessionizer -s 1\n"
# bindkey -s '\en' "tmux-sessionizer -s 2\n"
# bindkey -s '\es' "tmux-sessionizer -s 3\n"

# cat range (from line $1 to line $2 of file $3)
catr() {
    tail -n "+$1" $3 | head -n "$(($2 - $1 + 1))"
}

cat1Line() {
    cat $1 | tr -d "\n"
}


addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$PATH:$1
    fi
}

addToPathFront() {
    if [[ ! -z "$2" ]] || [[ "$PATH" != *"$1"* ]]; then
        export PATH=$1:$PATH
    fi
}

addToPathFront $HOME/.local/apps
addToPathFront $HOME/.local/scripts
addToPathFront $HOME/.local/bin
addToPathFront $HOME/.juliaup/bin
addToPath $HOME/.cargo/bin

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# nvm. The installer in runs/node appends this to whichever rc it finds, which
# means a later `./dev-env` overwrites it back out of ~/.zshrc.local. Keeping it
# in the layer makes it survive re-provisioning.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
