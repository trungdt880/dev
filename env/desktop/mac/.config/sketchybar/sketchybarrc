# Icon font: Hack Nerd Font
# Search for icons here: https://www.nerdfonts.com/cheat-sheet

CONFIG_DIR="$HOME/.config/sketchybar"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

# Private-use glyphs built via printf so the bytes survive editing.
CLOCK_GLYPH=$(printf '\357\200\227')     # U+F017 clock
CALENDAR_GLYPH=$(printf '\357\221\225')  # U+F455 calendar

############## BAR ##############
# Transparent bar; each region draws its own floating "island" (see brackets below).
sketchybar --bar height=32 \
                 y_offset=8 \
                 margin=10 \
                 position=top \
                 padding_left=8 \
                 padding_right=8 \
                 corner_radius=12 \
                 blur_radius=0 \
                 notch_width=200 \
                 color=0x00000000 \
                 shadow=off

############## GLOBAL DEFAULTS ##############
sketchybar --default updates=when_shown \
                     icon.font="Hack Nerd Font:Bold:14.0" \
                     icon.color=$ICON_COLOR \
                     icon.highlight_color=$ACCENT \
                     label.font="Hack Nerd Font:Bold:13.0" \
                     label.color=$LABEL_COLOR \
                     label.padding_left=4 \
                     label.padding_right=4 \
                     icon.padding_left=6 \
                     icon.padding_right=6 \
                     background.corner_radius=8 \
                     background.height=24 \
                     background.padding_left=4 \
                     background.padding_right=4 \
                     padding_left=2 \
                     padding_right=2

############## LOGO ##############
sketchybar --add item logo left \
           --set logo icon.background.image="$CONFIG_DIR/catto_centered.png" \
                      icon.background.drawing=on \
                      icon.background.image.scale=0.02 \
                      icon.color=$CRUST \
                      icon.y_offset=0 \
                      icon.padding_left=8 \
                      icon.padding_right=6 \
                      background.color=$TRANSPARENT \
                      background.padding_right=2 \
                      background.padding_left=2 \
                      click_script="sketchybar --update"

############## WORKSPACES (aerospace) ##############
sketchybar --add event aerospace_workspace_change

# Map aerospace monitor-id -> sketchybar display id
map=( $(aerospace list-monitors --format '%{monitor-id} %{monitor-appkit-nsscreen-screens-id}') )
for ((i=0; i<${#map[@]}; i+=2)); do
  monitors[${map[i]}]=${map[i+1]}
done

SPACE_ITEMS=()
for m in $(aerospace list-monitors | awk '{print $1}'); do
  for sid in $(aerospace list-workspaces --monitor $m); do
      SPACE_ITEMS+=(space.$sid)
      sketchybar --add item space.$sid left \
          --subscribe space.$sid aerospace_workspace_change \
          --set space.$sid \
          icon=○ \
          icon.font="Hack Nerd Font:Regular:16.0" \
          icon.color=$OVERLAY0 \
          icon.highlight_color=$ACCENT \
          icon.padding_left=5 \
          icon.padding_right=5 \
          background.padding_left=-2 \
          background.padding_right=-2 \
          background.drawing=off \
          label.drawing=off \
          display=${monitors["$m"]} \
          click_script="aerospace workspace $sid" \
          script="$CONFIG_DIR/plugins/aerospace.sh $sid"
  done
done

# Left island: cat logo + workspace dots on one floating, blurred bracket.
sketchybar --add bracket left_island logo "${SPACE_ITEMS[@]}" \
           --set left_island background.color=$BAR_COLOR \
                             background.corner_radius=12 \
                             background.height=28 \
                             background.padding_left=8 \
                             background.padding_right=8 \
                             background.y_offset=1 \
                             background.drawing=on \
                             blur_radius=30 \
                             background.shadow.drawing=on \
                             background.shadow.color=$SHADOW_COLOR \
                             background.shadow.distance=4

############## CENTER: SPOTIFY (disabled) ##############
# source "$CONFIG_DIR/plugins/spotify.sh"

############## RIGHT ITEMS ##############
# Layout per group: [colored icon chip][value label].
# Spacing: icon hugs its value (intra gap small); groups separated (inter gap large).
#   chip:  padding_left=12 (group gap)  padding_right=2 (hug value)
#   value: padding_left=2  (hug icon)   padding_right=2

# --- Battery ---
sketchybar --add item battery right \
           --set battery update_freq=120 \
                         icon.drawing=off \
                         script="$CONFIG_DIR/plugins/power.sh" \
                         label.color=$TEXT \
                         background.color=$TRANSPARENT \
                         padding_left=2 \
                         padding_right=2 \
           --subscribe battery system_woke power_source_change

sketchybar --add item power_logo right \
           --set power_logo icon=󰂄 \
                            icon.color=$CRUST \
                            icon.padding_left=7 \
                            icon.padding_right=7 \
                            label.drawing=off \
                            background.color=$GREEN \
                            padding_left=4 \
                            padding_right=2

# --- Date ---
sketchybar --add item date right \
           --set date update_freq=30 \
                      icon.drawing=off \
                      script="$CONFIG_DIR/plugins/date.sh" \
                      label.color=$TEXT \
                      background.color=$TRANSPARENT \
                      padding_left=2 \
                      padding_right=2

sketchybar --add item clock_logo right \
           --set clock_logo icon="$CALENDAR_GLYPH" \
                            icon.color=$CRUST \
                            icon.padding_left=7 \
                            icon.padding_right=7 \
                            label.drawing=off \
                            background.color=$MAUVE \
                            padding_left=8 \
                            padding_right=2

# --- Time ---
sketchybar --add item time right \
           --set time update_freq=10 \
                      icon.drawing=off \
                      script="$CONFIG_DIR/plugins/time.sh" \
                      label.color=$TEXT \
                      background.color=$TRANSPARENT \
                      padding_left=2 \
                      padding_right=0

sketchybar --add item time_logo right \
           --set time_logo icon="$CLOCK_GLYPH" \
                           icon.color=$CRUST \
                           icon.padding_left=7 \
                           icon.padding_right=7 \
                           label.drawing=off \
                           background.color=$BLUE \
                           padding_left=12 \
                           padding_right=2

# Right island: time / date / battery on one floating, blurred bracket.
sketchybar --add bracket right_island time_logo time clock_logo date power_logo battery \
           --set right_island background.color=$BAR_COLOR \
                              background.corner_radius=12 \
                              background.height=28 \
                              background.padding_left=2 \
                              background.padding_right=8 \
                              background.y_offset=1 \
                              background.drawing=on \
                              blur_radius=30 \
                              background.shadow.drawing=on \
                              background.shadow.color=$SHADOW_COLOR \
                              background.shadow.distance=4

############## FINALIZE ##############
sketchybar --update

echo "sketchybar configuration loaded..."
